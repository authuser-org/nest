{
  "info": {
    "_postman_id": "90273fc0-d706-4cc4-a1cb-authusernest",
    "name": "@authuser/nest example",
    "description": "Requests for the local @authuser/nest example.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    }
  ],
  "item": [
    {
      "name": "Application info",
      "request": { "method": "GET", "url": "{{baseUrl}}/api" }
    },
    {
      "name": "List users",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users" }
    },
    {
      "name": "Filter users with query parameter",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users?email=ada@example.com"
      }
    },
    {
      "name": "Query users with RFC 10008",
      "request": {
        "method": "QUERY",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ada@example.com\"\n}"
        },
        "url": "{{baseUrl}}/api/users/search"
      }
    },
    {
      "name": "Get user",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users/1" }
    },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Grace Hopper\",\n  \"email\": \"grace@example.com\"\n}"
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "Invalid user (validation)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\",\n  \"unexpected\": true\n}"
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "Replace user",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ada Byron\",\n  \"email\": \"ada.byron@example.com\"\n}"
        },
        "url": "{{baseUrl}}/api/users/1"
      }
    },
    {
      "name": "Delete user",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/users/1" }
    },
    {
      "name": "CORS preflight for PUT",
      "request": {
        "method": "OPTIONS",
        "header": [
          { "key": "Origin", "value": "http://localhost:3000" },
          { "key": "Access-Control-Request-Method", "value": "PUT" },
          { "key": "Access-Control-Request-Headers", "value": "content-type" }
        ],
        "url": "{{baseUrl}}/api/users/1"
      }
    },
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Readiness",
      "request": { "method": "GET", "url": "{{baseUrl}}/ready" }
    },
    {
      "name": "OpenAPI",
      "request": { "method": "GET", "url": "{{baseUrl}}/openapi.json" }
    }
  ]
}
